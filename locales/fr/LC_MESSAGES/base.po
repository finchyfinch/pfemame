"  3 (Joy-3) = Add / remove favorite\n"
"  4 (Joy-5) = Change the sort order\n"
"  7 (Joy-6) = Choose a category\n"
"  5 = Adjust tile brightness\n"
"  6 = Bring up the Finder"
msgstr ""
"NAVIGATION :\n"
"  GAUCHE = Déplacer vers la gauche\n"
"  DROITE = Déplacer vers la droite\n"
"  HAUT = Monter\n"
"  BAS = Descendre\n"
"  PGUP / PGDN = Déplacer une page\n"
"  HOME / END = Première / dernière ROM\n"
"ACTIONS :\n"
"  L-CTRL(Joy-2) = Changer le mode d'affichage\n"
"  ALT-1 (Joie-4) = Menu\n"
"  1 / ENTER (Joy-1) = Démarrer la ROM sélectionnée\n"
"  2 / ESC = Quitter la vue en mosaïque\n"
"  3 (Joy-3) = Ajouter/supprimer un favori\n"
"  4 (Joy-5) = Changer l'ordre de tri\n"
"  7 (Joy-6) = Choisissez une catégorie\n"
"  5 = Ajuster la luminosité des carreaux\n"
"  6 = Afficher le Finder"

