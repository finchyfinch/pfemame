"  ВПРАВО = двигаться вправо\n"
"  ВВЕРХ = двигаться вверх\n"
"  ВНИЗ = двигаться вниз\n"
"  PGUP/PGDN = Переместить страницу\n"
"  HOME/END = Первый/последний ROM\n"
"ДЕЙСТВИЯ:\n"
"  L-CTRL(Joy-2) = Сменить режим просмотра\n"
"  ALT-1 (Joy-4) = Меню\n"
"  1/ENTER (Joy-1) = Запустить выбранный ROM\n"
"  2 / ESC = выйти из просмотра плитки\n"
"  3 (Joy-3) = Добавить/удалить избранное\n"
"  4 (Joy-5) = Изменить порядок сортировки\n"
"  7 (Joy-6) = Выберите категорию\n"
"  5 = настроить яркость плитки\n"
"  6 = Откройте Finder"

