#: tileview.py:1917
msgid ""
"NAVIGATION:\n"
"  LEFT = Move left\n"
"  RIGHT = Move right\n"
"  UP = Move up\n"
"  DOWN = Move down\n"
"  PGUP / PGDN = Move a page\n"
"  HOME / END = First / last ROM\n"
"ACTIONS:\n"
"  L-CTRL(Joy-2) = Change view mode\n"
"  ALT-1 (Joy-4) = Menu\n"
"  1 / ENTER (Joy-1) = Start the selected ROM\n"
"  2 / ESC = Exit Tile View\n"
"  3 (Joy-3) = Add / remove favorite\n"
"  4 (Joy-5) = Change the sort order\n"
"  7 (Joy-6) = Choose a category\n"
"  5 = Adjust tile brightness\n"
"  6 = Bring up the Finder"
msgstr ""
"NAVIGATION:\n"
"  LINKS = Nach links bewegen\n"
"  RECHTS = Nach rechts bewegen\n"
"  UP = Nach oben bewegen\n"
"  DOWN = Nach unten bewegen\n"
"  PGUP / PGDN = Eine Seite verschieben\n"
"  HOME / END = Erstes / letztes ROM\n"
"AKTIONEN:\n"
"  L-STRG(Joy-2) = Ansichtsmodus wechseln\n"
"  ALT-1 (Joy-4) = Menü\n"
"  1 / ENTER (Joy-1) = Startet das ausgewählte ROM\n"
"  2 / ESC = Kachelansicht verlassen\n"
"  3 (Joy-3) = Favorit hinzufügen/entfernen\n"
"  4 (Joy-5) = Sortierreihenfolge ändern\n"
"  7 (Joy-6) = Wählen Sie eine Kategorie\n"
"  5 = Kachelhelligkeit anpassen\n"
"  6 = Rufen Sie den Finder auf"

