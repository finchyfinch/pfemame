#: tileview.py:1917
msgid ""
"NAVIGATION:\n"
"  LEFT = Move left\n"
"  RIGHT = Move right\n"
"  UP = Move up\n"
"  DOWN = Move down\n"
"  PGUP / PGDN = Move a page\n"
"  HOME / END = First / last ROM\n"
"ACTIONS:\n"
"  L-CTRL(Joy-2) = Change view mode\n"
"  ALT-1 (Joy-4) = Menu\n"
"  1 / ENTER (Joy-1) = Start the selected ROM\n"
"  2 / ESC = Exit Tile View\n"
"  3 (Joy-3) = Add / remove favorite\n"
"  4 (Joy-5) = Change the sort order\n"
"  7 (Joy-6) = Choose a category\n"
"  5 = Adjust tile brightness\n"
"  6 = Bring up the Finder"
msgstr ""
"导航：\n"
"  左 = 向左移动\n"
"  右 = 向右移动\n"
"  向上 = 向上移动\n"
"  向下 = 向下移动\n"
"  PGUP / PGDN = 移动页面\n"
"  HOME / END = 第一个/最后一个 ROM\n"
"行动：\n"
"  L-CTRL(Joy-2) = 更改视图模式\n"
"  ALT-1 (Joy-4) = 菜单\n"
"  1 / ENTER (Joy-1) = 启动选定的 ROM\n"
"  2 / ESC = 退出平铺视图\n"
"  3 (Joy-3) = 添加/删除收藏夹\n"
"  4 (Joy-5) = 更改排序顺序\n"
"  7 (Joy-6) = 选择一个类别\n"
"  5 = 调整图块亮度\n"
"  6 = 调出取景器"

