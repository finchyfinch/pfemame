#: tileview.py:1917
msgid ""
"NAVIGATION:\n"
"  LEFT = Move left\n"
"  RIGHT = Move right\n"
"  UP = Move up\n"
"  DOWN = Move down\n"
"  PGUP / PGDN = Move a page\n"
"  HOME / END = First / last ROM\n"
"ACTIONS:\n"
"  L-CTRL(Joy-2) = Change view mode\n"
"  ALT-1 (Joy-4) = Menu\n"
"  1 / ENTER (Joy-1) = Start the selected ROM\n"
"  2 / ESC = Exit Tile View\n"
"  3 (Joy-3) = Add / remove favorite\n"
"  4 (Joy-5) = Change the sort order\n"
"  7 (Joy-6) = Choose a category\n"
"  5 = Adjust tile brightness\n"
"  6 = Bring up the Finder"
msgstr ""
"ナビゲーション:\n"
"  LEFT = 左に移動\n"
"  RIGHT = 右に移動\n"
"  UP = 上に移動\n"
"  下 = 下に移動します\n"
"  PGUP / PGDN = ページを移動します\n"
"  HOME / END = 最初/最後のROM\n"
"アクション:\n"
"  L-CTRL(Joy-2) = 表示モードを変更\n"
"  ALT-1 (Joy-4) = メニュー\n"
"  1 / ENTER (Joy-1) = 選択したROMを開始します\n"
"  2 / ESC = タイルビューを終了\n"
"  3 (Joy-3) = お気に入りの追加/削除\n"
"  4 (Joy-5) = 並べ替え順序を変更します\n"
"  7 (Joy-6) = カテゴリを選択してください\n"
"  5 = タイルの明るさを調整します\n"
"  6 = ファインダーを起動します"

